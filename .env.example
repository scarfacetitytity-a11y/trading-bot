# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.

# ── MT5 broker ────────────────────────────────────────────────────────────────
MT5_LOGIN=00000000
MT5_PASSWORD=your-password
MT5_SERVER=FTMO-Demo

# ── Telegram (trade alerts + pre-day brief) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Multi-model AI advisory layer ─────────────────────────────────────────────
# Set any/all of these to activate models. Each provider is independent.
# Models are queried in parallel — only keys that are set will be called.
# Use in terminal: python -m execution.llm_advisor "your question"
# Use --list to see all models and active status.

# OpenRouter — 20 req/min free — routes to 100+ models (Qwen, Llama, Gemma, etc.)
# Get key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Groq — 14,400 req/day free — fastest inference (Llama 3.3 70B, Mixtral)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Together AI — free credits on signup — Llama/Mistral variants
# Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Google Gemini — free tier via AI Studio (Gemini 2.0 Flash)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral AI — free tier on La Plateforme
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
