# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.

# MT5 broker credentials
MT5_LOGIN=00000000
MT5_PASSWORD=your-password
MT5_SERVER=Broker-Server

# Telegram bot (for trade alerts and pre-day brief)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# LLM advisory layer (optional — set either or both to enable multi-model advisory)
# OpenRouter free tier: 20 req/min — https://openrouter.ai/
OPENROUTER_API_KEY=
# Groq free tier: 14,400 req/day — https://console.groq.com/
GROQ_API_KEY=
