# Virtual environment
venv/
.venv/

# Python bytecode / packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets / local config
.env
config/config.yaml

# Logs — runtime state and outputs (regenerated on run)
logs/
!logs/.gitkeep

# Historical/processed data (regenerate from source, don't commit)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Editor/IDE
.vscode/
.idea/

# BASE knowledge graph (auto-generated, local only)
.base/
.base-ast-cache/

# Autoresearch results — untracked per program.md
research/results.tsv
research/run.log

# Temp files
*.b64

